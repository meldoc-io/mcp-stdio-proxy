{
  "name": "@meldocio/mcp-stdio-proxy",
  "version": "1.1.0",
  "description": "Stdio bridge to the hosted Meldoc MCP server, for MCP clients that cannot connect to a remote server",
  "bin": {
    "meldoc-mcp": "bin/meldoc-mcp-proxy.js"
  },
  "files": [
    "bin/**",
    "lib/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:local": "MELDOC_API_URL=http://localhost:8080 MELDOC_APP_URL=http://localhost:4200 jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm test",
    "publish:patch": "npm version patch --no-git-tag-version && npm publish",
    "publish:minor": "npm version minor --no-git-tag-version && npm publish"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "claude-code",
    "meldoc",
    "documentation",
    "knowledge-base",
    "ai",
    "stdio",
    "proxy",
    "json-rpc"
  ],
  "author": "Meldoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meldoc-io/mcp-stdio-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/meldoc-io/mcp-stdio-proxy/issues"
  },
  "homepage": "https://github.com/meldoc-io/mcp-stdio-proxy#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "bin/**/*.js",
      "lib/**/*.js"
    ],
    "testTimeout": 10000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ]
  }
}
